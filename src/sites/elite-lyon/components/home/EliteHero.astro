---
import { Image } from 'astro:assets';
import heroImage from '../../assets/images/elite-van-hero-city.png';
import EliteBookingWidget from './EliteBookingWidget.astro';
---

<section
  id='hero'
  class='relative min-h-screen flex items-center pt-24 pb-12 overflow-hidden bg-black'>
  <div class='absolute inset-0 z-0'>
    <Image
      class='w-full h-full object-cover opacity-90'
      src={heroImage}
      alt='Elite Chauffeur City'
      loading='eager'
      format='webp'
      quality='high'
    />
    <!-- Filtre Bleu Acier Léger -->
    <div class='absolute inset-0 bg-[#6185b2]/10 mix-blend-color'></div>
    <!-- Dégradé Réduit -->
    <div class='absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent'>
    </div>
  </div>
  <div class='container mx-auto px-8 relative z-10 grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12'>
    <div class='lg:col-span-7 flex flex-col justify-center items-center lg:items-start text-center lg:text-left'>
      <span
        class='text-elite-accent font-label font-bold tracking-[0.3em] uppercase mb-3 text-[10px]'
        >Premium Fleet Service</span
      >
      <h1
        class='text-white font-headline text-4xl md:text-8xl font-extrabold tracking-tighter leading-[0.9] mb-4 lg:mb-8 uppercase'>
        Chauffeur<br class="hidden lg:inline" /> <span class='text-elite-accent'>Privé</span> De Luxe
      </h1>
      <p class='text-white/60 font-body text-base md:text-xl max-w-xl mx-auto lg:mx-0 mb-6 lg:mb-12 leading-relaxed'>
        L'excellence opérationnelle pour vos déplacements stratégiques. Discrétion, ponctualité et
        prestige.
      </p>
      <div class='hidden lg:flex flex-wrap gap-6'>
        <button
          class='btn-premium px-10 py-5 rounded-sm font-headline font-bold text-sm uppercase tracking-[0.2em]'>
          Réserver un trajet
        </button>
        <button
          class='border border-white/20 text-white px-10 py-5 rounded-sm font-headline font-medium text-sm uppercase tracking-[0.2em] backdrop-blur-sm hover:bg-white/10 transition-colors'>
          La Flotte
        </button>
      </div>
    </div>
    <div id='booking' class='lg:col-span-5 flex items-center w-full'>
      <EliteBookingWidget />
    </div>
  </div>
</section>
