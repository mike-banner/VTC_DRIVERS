---
// src/components/home/infoServicePremium.astro
---

<div class='mb-20 text-center'>
  <span class='text-elite-accent font-label font-bold tracking-[0.3em] uppercase text-[10px]'
    >Excellence Concept</span
  >
  <h2
    class='text-black font-headline text-4xl md:text-6xl font-extrabold tracking-tighter mt-4 uppercase'>
    Services Premium
  </h2>
</div>
<div class='grid grid-cols-1 md:grid-cols-3 gap-16'>
  <!-- Service 1 -->
  <a
    href='/tunnels/airport'
    class='group border-l border-black/5 pl-8 hover:border-elite-accent transition-colors duration-500 block focus:outline-none'>
    <div class='mb-8 text-elite-accent'>
      <span class='material-symbols-outlined text-5xl'>flight_takeoff</span>
    </div>
    <h3 class='font-headline text-xl font-bold text-black mb-4 uppercase tracking-tight'>
      Transferts Aéroport
    </h3>
    <p class='text-black/50 font-body leading-relaxed text-sm'>
      Accueil VIP personnalisé avec tablette nominative et suivi en temps réel de votre vol.
    </p>
  </a>
  <!-- Service 2 -->
  <a
    href='/tunnels/business'
    class='group border-l border-black/5 pl-8 hover:border-elite-accent transition-colors duration-500 block focus:outline-none'>
    <div class='mb-8 text-elite-accent'>
      <span class='material-symbols-outlined text-5xl'>auto_awesome</span>
    </div>
    <h3 class='font-headline text-xl font-bold text-black mb-4 uppercase tracking-tight'>
      Événementiel
    </h3>
    <p class='text-black/50 font-body leading-relaxed text-sm'>
      Logistique de transport haut de gamme pour vos congrès, séminaires et célébrations privées.
    </p>
  </a>
  <!-- Service 3 -->
  <a
    href='/tunnels/availability'
    class='group border-l border-black/5 pl-8 hover:border-elite-accent transition-colors duration-500 block focus:outline-none'>
    <div class='mb-8 text-elite-accent'>
      <span class='material-symbols-outlined text-5xl'>history_toggle_off</span>
    </div>
    <h3 class='font-headline text-xl font-bold text-black mb-4 uppercase tracking-tight'>
      Mise à Disposition
    </h3>
    <p class='text-black/50 font-body leading-relaxed text-sm'>
      Flexibilité absolue avec un chauffeur dédié pour la durée de vos besoins opérationnels.
    </p>
  </a>
</div>
