---
// src/components/home/ServicesGrid.astro
import type { ImageMetadata } from 'astro';
import { Icon } from 'astro-icon/components';
import { Image } from 'astro:assets';
import availabilityImg from '../../assets/images/elite-availability.jpg';

interface Service {
  title: string;
  image: string | ImageMetadata;
  desc: string;
  link: string;
}

const services: Service[] = [
  {
    title: "Transferts Aéroport",
    image: "https://images.unsplash.com/photo-1436491865332-7a61a1092e51?q=80&w=2070&auto=format&fit=crop",
    desc: "Service ponctuel vers Lyon Saint-Exupéry, CDG ou Orly.",
    link: "/tunnels/airport"
  },
  {
    title: "Longue Distance",
    image: "https://images.unsplash.com/photo-1469854523086-cc02fe5d8800?q=80&w=2021&auto=format&fit=crop",
    desc: "Déplacements interurbains dans toute la France sous 24h.",
    link: "/tunnels/long-distance"
  },
  {
    title: "Business & B2B",
    image: "https://images.unsplash.com/photo-1507679799987-c73779587ccf?q=80&w=2071&auto=format&fit=crop",
    desc: "Solutions de mobilité pour vos collaborateurs et VIP.",
    link: "/tunnels/business"
  },
  {
    title: "Mise à Disposition",
    image: availabilityImg,
    desc: "Un chauffeur à votre service à l'heure ou à la journée.",
    link: "/tunnels/availability"
  }
];
---

<section class="py-24 bg-white font-sans">
  <div class="container mx-auto px-6">
    <div class="text-center mb-20">
      <span class="text-[10px] font-bold uppercase tracking-[0.3em] text-accent mb-4 block">NOS PRESTATIONS</span>
      <h2 class="text-3xl md:text-5xl font-semibold tracking-tight text-zinc-900 leading-tight">
        L'excellence du <span class="text-zinc-500">sur-mesure</span>
      </h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      {services.map((s) => (
        <a href={s.link} class="relative group h-[400px] overflow-hidden rounded-sm bg-zinc-100 block">
          <Image
            src={s.image as any}
            alt={s.title}
            width={800}
            height={400}
            class="w-full h-full object-cover transition-all duration-700 brightness-75 group-hover:brightness-50 group-hover:scale-105"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent"></div>

          <div class="absolute inset-0 p-8 flex flex-col justify-end translate-y-4 group-hover:translate-y-0 transition-transform duration-500">
             <span class="text-[9px] font-bold uppercase tracking-[0.2em] text-accent mb-2 opacity-0 group-hover:opacity-100 transition-opacity">Signature</span>
             <h4 class="text-xl font-semibold text-white tracking-tight mb-2">{s.title}</h4>
             <p class="text-zinc-300 text-xs font-normal leading-relaxed opacity-0 group-hover:opacity-100 transition-opacity duration-300">
               {s.desc}
             </p>
          </div>

          <!-- Icon: Black on White -> White on Black -->
          <div class="absolute top-8 right-8 w-10 h-10 bg-white text-black flex items-center justify-center rounded-full opacity-0 group-hover:opacity-100 transition-all duration-500 -translate-y-2 group-hover:translate-y-0 hover:bg-black hover:text-white border border-transparent hover:border-white/20">
             <Icon name="ri:arrow-right-line" class="text-lg" />
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
